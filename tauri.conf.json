      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMzc5RDlEOTdBNjk2QTEKUldTaGxxYVhuWjAzVE03aWNVL1U0RWk5U1dYSzlOZXNFUXVQa0FTVEI5bmkwWkJGUFUzZUVXQjQK",
      "endpoints": [
        "https://github.com/dbalchunas2-pixel/warden/releases/latest/download/latest.json"
      ]
