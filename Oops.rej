 function groupOf(n){for(const g in NAV)if(NAV[g].includes(n))return g;return null;}
 function renderNavGroups(){const nav=document.getElementById('nav-groups');nav.innerHTML='';for(const g in NAV){const b=document.createElement('button');b.className='nav-btn';b.dataset.group=g;b.textContent=VLABEL[g];b.onclick=()=>showView(NAV[g][0]);nav.appendChild(b);}}
 function showView(n,b){const g=groupOf(n);document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));document.querySelectorAll('.nav-btn').forEach(x=>x.classList.remove('active'));document.getElementById('view-'+n).classList.add('active');if(g){document.querySelectorAll('[data-group]').forEach(x=>{if(x.dataset.group===g)x.classList.add('active');});const sn=document.getElementById('subnav');sn.innerHTML='';NAV[g].forEach(v=>{const sb=document.createElement('button');sb.className='sub-btn'+(v===n?' active':'');sb.textContent=VLABEL[v];sb.onclick=()=>showView(v);sn.appendChild(sb);});}
