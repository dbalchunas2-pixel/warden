use std::time::Duration;
#[tokio::main]
async fn main() {
    let key = std::env::var("NEBIUS_API_KEY").unwrap_or_default();
    for i in 0..6 {
        let client = reqwest::Client::builder()
            .timeout(Duration::from_secs(8))
            .connect_timeout(Duration::from_secs(3))
            .build().unwrap();
        let t = std::time::Instant::now();
        let r = client.post("https://api.tokenfactory.nebius.com/v1/chat/completions")
            .header("Authorization", format!("Bearer {}", key))
            .json(&serde_json::json!({"model":"nvidia/Nemotron-3_5-Lightning","messages":[{"role":"user","content":"say ok"}],"max_tokens":4}))
            .send().await;
        match r {
            Ok(resp) => println!("#{} OK {} in {:?}", i, resp.status(), t.elapsed()),
            Err(e) => println!("#{} ERR in {:?} :: {:?}", i, t.elapsed(), e),
        }
        tokio::time::sleep(Duration::from_millis(500)).await;
    }
}
